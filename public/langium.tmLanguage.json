{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Langium",
  "scopeName": "source.langium",
  "fileTypes": ["langium"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#regex" },
    { "include": "#keyword" },
    { "include": "#type-name" },
    { "include": "#property" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.langium",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.langium",
          "match": "//[^\\n\\r]*"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.langium",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.langium", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.langium",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.langium", "match": "\\\\." }]
        }
      ]
    },
    "regex": {
      "name": "string.regexp.langium",
      "match": "/(?![*+?])(?:[^\\r\\n\\[/\\\\]|\\\\.|(\\[(?:[^\\r\\n\\]\\\\]|\\\\.)*\\]))+/"
    },
    "keyword": {
      "name": "keyword.control.langium",
      "match": "\\b(interface|fragment|terminal|boolean|current|extends|grammar|returns|bigint|hidden|import|infers|number|string|entry|false|infer|Date|true|type|with|on|infix|left|right|assoc)\\b"
    },
    "type-name": {
      "name": "entity.name.type.langium",
      "match": "\\b[A-Z][\\w]*\\b"
    },
    "property": {
      "name": "variable.other.property.langium",
      "match": "\\b[a-z][\\w]*(?==|\\?=|\\+=|\\??:)"
    }
  }
}
